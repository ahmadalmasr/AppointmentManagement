@model List<Appointment>
@{
    ViewData["Title"] = "Appointments";
    var selected = ViewBag.SelectedStatus as AppointmentStatus?;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Appointments</h2>
    <a class="btn btn-primary" asp-action="Create">+ New Appointment</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <select name="status" class="form-select"
                asp-items="Html.GetEnumSelectList<AppointmentStatus>()">
            <option value="">All statuses</option>
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary">Filter</button>
        <a asp-action="Index" class="btn btn-link">Reset</a>
    </div>
</form>

@if (!Model.Any())
{
    <div class="alert alert-info">No appointments found.</div>
}
else
{
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Customer</th>
                <th>Email</th>
                <th>Date</th>
                <th>Time</th>
                <th>Notes</th>
                <th>Status</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var a in Model)
        {
            <tr>
                <td>@a.CustomerName</td>
                <td>@a.CustomerEmail</td>
                <td>@a.AppointmentDate?.ToString("yyyy-MM-dd")</td>
                <td>@a.AppointmentTime?.ToString("HH:mm")</td>
                <td>@a.Notes</td>
                <td>
                    <span class="badge @(a.Status == AppointmentStatus.Scheduled ? "bg-primary" : a.Status == AppointmentStatus.Completed ? "bg-success" : "bg-secondary")">@a.Status</span>
                </td>
                <td class="text-end">
                    <a class="btn btn-sm btn-warning" asp-action="Edit" asp-route-id="@a.Id">Edit</a>
                    <form asp-action="Delete" asp-route-id="@a.Id" method="post" class="d-inline"
                          onsubmit="return confirm('Are you sure you want to delete this appointment?');">
                        <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
}
